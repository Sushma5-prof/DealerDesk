# Copy this file to .env for local development. Never commit .env.
# The grader deletes any .env it finds and supplies its own environment variables.

# ── Database (PostgreSQL only) ─────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealerdesk

# ── Supplier API (run supplier_mock/mock_supplier.py locally) ──────────────────
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=dev-supplier-key

# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1

# ── LLM provider — fill in exactly ONE key (the one you have) ─────────────────
# The grader supplies its own key for whichever provider your code reads.
# Primary: Google Gemini (free tier sufficient for development)
GEMINI_API_KEY=
# Alternatives (uncomment the one you use):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
